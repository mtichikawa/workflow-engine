# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Env / secrets
.env
.env.*

# Runtime state + generated artifacts — not source.
# Curated example corpora (baseline + per-domain/tenant scopes) ARE source -> tracked.
# Transient test scopes are churn -> ignored explicitly.
state/*
!state/examples/
state/examples/t1/
state/examples/t2/

# Private companion repo (working notes + golds that can't be redistributed). Its own git repo,
# never tracked here — tests/test_private_boundary.py fails if anything under it is.
/private/
logs/
output/
scratch/

# OS / editor
.DS_Store
.idea/
.vscode/
*.backup-*
